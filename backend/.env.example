PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/secure_content_portal
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ADMIN_EMAILS=admin@yourdomain.com
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# --- Cloudinary Storage (Recommended for production — free tier) ---
# Sign up at https://cloudinary.com — free tier gives 25GB storage
# Dashboard -> Account Details
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Supabase Storage (Alternative for production) ---
# Create a free project at https://supabase.com
# Go to Storage -> Create a private bucket named "portal-content"
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=portal-content

# --- Local File Storage (fallback when no cloud storage is configured) ---
STORAGE_PATH=./private_uploads
MAX_FILE_SIZE_MB=100
